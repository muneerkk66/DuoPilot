OPENAI_API_KEY=sk-...
# Use a model available to your OpenAI API project.
OPENAI_MODEL=gpt-5.6

# Optional: connect a trusted LOCAL MCP server for capabilities beyond DuoPilot's
# built-in scoped project, Xcode and Simulator tools.
DUOPILOT_MCP_COMMAND=
DUOPILOT_MCP_ARGS=[]

# Safety: false means DuoPilot should inspect/plan but not make code-changing tool calls.
DUOPILOT_ALLOW_WRITES=false
