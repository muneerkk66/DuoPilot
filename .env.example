OPENAI_API_KEY=sk-...
# Use a model available to your OpenAI API project.
OPENAI_MODEL=gpt-5.6

# DuoPilot connects to a LOCAL MCP server that exposes Xcode / simulator tools.
# Example only — replace with the command for your MCP server.
DUOPILOT_MCP_COMMAND=npx
DUOPILOT_MCP_ARGS=["-y","your-xcode-mcp-package"]

# Safety: false means DuoPilot should inspect/plan but not make code-changing tool calls.
DUOPILOT_ALLOW_WRITES=false
